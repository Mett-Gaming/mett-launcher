<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MettLauncher.App</RootNamespace>
    <AssemblyName>MettLauncher</AssemblyName>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.7.0</Version>
    <Product>Mett Launcher</Product>
    <Company>Mett Gaming</Company>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
    <AvaloniaResource Include="..\..\assets\icon.png" Link="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Peer-to-Peer-Netzdienst (Rust, native/mett-netd). Release-Build bevorzugt, sonst Debug. -->
  <PropertyGroup>
    <MettNetdExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">mett-netd.exe</MettNetdExe>
    <MettNetdExe Condition="'$(MettNetdExe)' == ''">mett-netd</MettNetdExe>
    <MettNetdRelease>$(MSBuildThisFileDirectory)../../native/target/release/$(MettNetdExe)</MettNetdRelease>
    <MettNetdDebug>$(MSBuildThisFileDirectory)../../native/target/debug/$(MettNetdExe)</MettNetdDebug>
    <MettNetdPath Condition="Exists('$(MettNetdRelease)')">$(MettNetdRelease)</MettNetdPath>
    <MettNetdPath Condition="'$(MettNetdPath)' == '' And Exists('$(MettNetdDebug)')">$(MettNetdDebug)</MettNetdPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(MettNetdPath)' != ''">
    <None Include="$(MettNetdPath)" Link="$(MettNetdExe)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Overlay-Schicht (Rust, native/mett-overlay) -->
  <PropertyGroup>
    <MettOverlayLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">mett_overlay.dll</MettOverlayLib>
    <MettOverlayLib Condition="'$(MettOverlayLib)' == ''">libmett_overlay.so</MettOverlayLib>
    <MettOverlayPath>$(MSBuildThisFileDirectory)../../native/target/release/$(MettOverlayLib)</MettOverlayPath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MettOverlayPath)')">
    <None Include="$(MettOverlayPath)" Link="$(MettOverlayLib)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MettLauncher.Core\MettLauncher.Core.csproj" />
  </ItemGroup>

</Project>
