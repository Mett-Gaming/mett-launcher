<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tokens aus Figma "Mett Launcher" (Farben aus dem Raptor-Logo). -->
  <Color x:Key="ColorBgApp">#120E0B</Color>
  <Color x:Key="ColorBgSidebar">#0D0A08</Color>
  <Color x:Key="ColorBgSurface">#1B1611</Color>
  <Color x:Key="ColorBgRaised">#241D17</Color>
  <Color x:Key="ColorBgHover">#2F261E</Color>
  <Color x:Key="ColorBgSelected">#3B2D21</Color>
  <Color x:Key="ColorBorderSubtle">#241D17</Color>
  <Color x:Key="ColorBorderDefault">#3B2D21</Color>
  <Color x:Key="ColorBorderStrong">#54402E</Color>
  <Color x:Key="ColorTextPrimary">#E8E0D1</Color>
  <Color x:Key="ColorTextSecondary">#AA9074</Color>
  <Color x:Key="ColorTextMuted">#7D6A55</Color>
  <Color x:Key="ColorAccent">#7E8758</Color>
  <Color x:Key="ColorAccentHover">#9AA36E</Color>
  <Color x:Key="ColorAccentPressed">#646B44</Color>
  <Color x:Key="ColorBrand">#C2A47F</Color>
  <Color x:Key="ColorHighlight">#D9ABAA</Color>
  <Color x:Key="ColorHighlightSubtle">#3A2526</Color>
  <Color x:Key="ColorLink">#8D97A1</Color>
  <Color x:Key="ColorInfoSubtle">#1E2227</Color>
  <Color x:Key="ColorDanger">#D2615A</Color>
  <Color x:Key="ColorDangerSubtle">#34191A</Color>
  <Color x:Key="ColorWarning">#D9A34A</Color>

  <SolidColorBrush x:Key="BgApp" Color="{StaticResource ColorBgApp}" />
  <SolidColorBrush x:Key="BgSidebar" Color="{StaticResource ColorBgSidebar}" />
  <SolidColorBrush x:Key="BgSurface" Color="{StaticResource ColorBgSurface}" />
  <SolidColorBrush x:Key="BgRaised" Color="{StaticResource ColorBgRaised}" />
  <SolidColorBrush x:Key="BgHover" Color="{StaticResource ColorBgHover}" />
  <SolidColorBrush x:Key="BgSelected" Color="{StaticResource ColorBgSelected}" />
  <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
  <SolidColorBrush x:Key="BorderDefault" Color="{StaticResource ColorBorderDefault}" />
  <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource ColorBorderStrong}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorTextPrimary}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}" />
  <SolidColorBrush x:Key="TextMuted" Color="{StaticResource ColorTextMuted}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="AccentHover" Color="{StaticResource ColorAccentHover}" />
  <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource ColorAccentPressed}" />
  <SolidColorBrush x:Key="Brand" Color="{StaticResource ColorBrand}" />
  <SolidColorBrush x:Key="Highlight" Color="{StaticResource ColorHighlight}" />
  <SolidColorBrush x:Key="HighlightSubtle" Color="{StaticResource ColorHighlightSubtle}" />
  <SolidColorBrush x:Key="Link" Color="{StaticResource ColorLink}" />
  <SolidColorBrush x:Key="InfoSubtle" Color="{StaticResource ColorInfoSubtle}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource ColorDanger}" />
  <SolidColorBrush x:Key="DangerSubtle" Color="{StaticResource ColorDangerSubtle}" />
  <SolidColorBrush x:Key="Warning" Color="{StaticResource ColorWarning}" />
  <SolidColorBrush x:Key="Scrim" Color="#000000" Opacity="0.6" />

  <LinearGradientBrush x:Key="PlayGradient" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#9AA36E" />
    <GradientStop Offset="1" Color="#6E7749" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PlayGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#AEB77F" />
    <GradientStop Offset="1" Color="#7E8758" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroFallback" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#2E3524" />
    <GradientStop Offset="0.55" Color="#17140F" />
    <GradientStop Offset="1" Color="#120E0B" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroFade" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.35" Color="#00120E0B" />
    <GradientStop Offset="1" Color="#F2120E0B" />
  </LinearGradientBrush>

  <FontFamily x:Key="UiFont">avares://MettLauncher/Assets/Fonts#Archivo</FontFamily>
  <FontFamily x:Key="DisplayFont">avares://MettLauncher/Assets/Fonts#Archivo Black</FontFamily>
  <FontFamily x:Key="MonoFont">avares://MettLauncher/Assets/Fonts#JetBrains Mono</FontFamily>

  <CornerRadius x:Key="RadiusSm">2</CornerRadius>
  <CornerRadius x:Key="RadiusMd">3</CornerRadius>
  <CornerRadius x:Key="RadiusLg">4</CornerRadius>
  <CornerRadius x:Key="RadiusXl">6</CornerRadius>

  <!-- Lucide-Icons (ISC), 24er Raster -->
  <StreamGeometry x:Key="IconPlay">M6 3 L20 12 L6 21 Z</StreamGeometry>
  <StreamGeometry x:Key="IconDownload">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M7 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z</StreamGeometry>
  <StreamGeometry x:Key="IconX">M18 6 6 18 M6 6l12 12</StreamGeometry>
  <StreamGeometry x:Key="IconMinus">M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="IconMaximize">M6 5h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M21 4h-7 M10 4H3 M21 12h-9 M8 12H3 M21 20h-5 M12 20H3 M14 2v4 M8 10v4 M16 18v4</StreamGeometry>
  <StreamGeometry x:Key="IconInfo">M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20z M12 16v-4 M12 8h.01</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M11 3a8 8 0 1 0 0 16a8 8 0 1 0 0-16z M21 21l-4.3-4.3</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
  <StreamGeometry x:Key="IconHome">M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10</StreamGeometry>
  <StreamGeometry x:Key="IconWifiOff">M2 2l20 20 M8.5 16.5a5 5 0 0 1 7 0 M2 8.82a15 15 0 0 1 4.17-2.65 M10.66 5c4.01-.36 8.14.9 11.34 3.76 M16.85 11.25a10 10 0 0 1 2.22 1.68 M5 13a10 10 0 0 1 5.24-2.76 M12 20h.01</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z</StreamGeometry>
  <StreamGeometry x:Key="IconTrophy">M6 9H4.5a2.5 2.5 0 0 1 0-5H6 M18 9h1.5a2.5 2.5 0 0 0 0-5H18 M4 22h16 M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22 M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22 M18 2H6v7a6 6 0 0 0 12 0V2z</StreamGeometry>
  <StreamGeometry x:Key="IconLock">M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M7 11V7a5 5 0 0 1 10 0v4</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M20 6 9 17l-5-5</StreamGeometry>
  <StreamGeometry x:Key="IconUsers">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 3a4 4 0 1 0 0 8a4 4 0 1 0 0-8z M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M10 8h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2</StreamGeometry>
</ResourceDictionary>
