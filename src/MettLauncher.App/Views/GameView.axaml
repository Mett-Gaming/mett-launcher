<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MettLauncher.App.ViewModels"
             xmlns:c="using:MettLauncher.App.Controls"
             xmlns:v="using:MettLauncher.App.Views"
             x:Class="MettLauncher.App.Views.GameView"
             x:DataType="vm:GameViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

      <!-- Hero mit Spieltitel -->
      <Grid Height="260" ClipToBounds="True">
        <Border Background="{StaticResource HeroFallback}" IsVisible="{Binding !HasHero}" />
        <Image Source="{Binding Hero}" Stretch="UniformToFill" IsVisible="{Binding HasHero}"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border Background="{StaticResource HeroFade}" />
        <TextBlock Classes="display" Text="{Binding Name}" Margin="32,0,32,24" VerticalAlignment="Bottom">
          <TextBlock.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="2" BlurRadius="12" Color="#99000000" />
          </TextBlock.Effect>
        </TextBlock>
      </Grid>

      <!-- Spielen-Leiste -->
      <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
              Padding="32,14">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="20">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <Button Classes="play" Classes.muted="{Binding PrimaryIsMuted}"
                    Command="{Binding PrimaryCommand}" IsVisible="{Binding ShowPrimary}"
                    AutomationProperties.AutomationId="PrimaryAction" AutomationProperties.Name="{Binding PrimaryLabel}">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <c:LucideIcon Width="20" Height="20" Data="{Binding PrimaryIcon, Converter={x:Static v:IconKeyConverter.Instance}}"
                              Filled="{Binding PrimaryFilledIcon}" />
                <TextBlock Text="{Binding PrimaryLabel}" FontWeight="Bold" FontSize="16" LetterSpacing="0.8" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- Update bekannt, trotzdem spielen (fragt vor dem Start nach) -->
            <Button Classes="secondary" Height="48" Command="{Binding StartGameCommand}" IsVisible="{Binding ShowSecondaryPlay}"
                    AutomationProperties.AutomationId="SecondaryPlay" AutomationProperties.Name="Spielen">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:LucideIcon Width="16" Height="16" Data="{StaticResource IconPlay}" Filled="True" />
                <TextBlock Text="SPIELEN" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Download läuft -->
          <Border Grid.Column="0" IsVisible="{Binding IsBusy}" Width="260" Height="48" Background="{StaticResource BgRaised}"
                  BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="14,6">
            <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="mono" Text="{Binding PercentText}" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Grid.RowSpan="2" Classes="ghost" Padding="4" Command="{Binding CancelInstallCommand}"
                      ToolTip.Tip="Abbrechen" AutomationProperties.Name="Download abbrechen" VerticalAlignment="Center">
                <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconX}" />
              </Button>
              <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Progress}" Maximum="1" Margin="0,4,0,2" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="overline" Text="ZULETZT GESPIELT" />
            <TextBlock Text="{Binding LastPlayedText}" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="overline" Text="SPIELZEIT" />
            <TextBlock Text="{Binding PlaytimeText}" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" />
          </StackPanel>
          <Panel Grid.Column="3" x:Name="AchievementsStat">
          <Button Classes="ghost" Padding="6,4" IsVisible="{Binding HasAchievements}" Command="{Binding ShowAchievementsCommand}"
                  ToolTip.Tip="Alle Erfolge anzeigen" AutomationProperties.Name="Alle Erfolge anzeigen" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:LucideIcon Width="20" Height="20" Data="{StaticResource IconTrophy}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              <StackPanel Spacing="4">
                <TextBlock Classes="overline" Text="ERFOLGE" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding AchievementsShort}" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" />
                  <ProgressBar Width="80" MinWidth="80" Value="{Binding AchievementsFraction}" Maximum="1" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Button>
          </Panel>

          <Button Grid.Column="4" Classes="secondary" HorizontalAlignment="Right" Height="40" IsVisible="{Binding IsMultiplayer}"
                  AutomationProperties.Name="Mit Freunden spielen">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:LucideIcon Width="16" Height="16" Data="{StaticResource IconUsers}" />
              <TextBlock Text="Mit Freunden" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Spiel hosten" Command="{Binding HostGameCommand}" />
                <MenuItem Header="Beitreten mit Code …" Command="{Binding JoinGameCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Grid.Column="5" Classes="icon" ToolTip.Tip="Verwalten" AutomationProperties.Name="Verwalten">
            <c:LucideIcon Width="18" Height="18" Data="{StaticResource IconSettings}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Lokalen Ordner öffnen" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding HasFolder}" />
                <MenuItem Header="Dateien überprüfen" Command="{Binding VerifyCommand}" IsEnabled="{Binding IsInstalled}" />
                <MenuItem Header="Version wählen …" Command="{Binding ShowVersionsCommand}" />
                <MenuItem Header="Proton-Version …" Command="{Binding ChooseProtonCommand}" IsVisible="{Binding UsesProton}" />
                <MenuItem Header="Wine-Prefix öffnen" Command="{Binding OpenPrefixCommand}" IsVisible="{Binding UsesProton}" />
                <MenuItem Header="Wine-Prefix zurücksetzen …" Command="{Binding AskResetPrefixCommand}" IsVisible="{Binding UsesProton}" />
                <Separator />
                <MenuItem Header="Automatisch aktualisieren" ToggleType="CheckBox" IsChecked="{Binding AutoUpdate, Mode=OneWay}"
                          Command="{Binding ToggleAutoUpdateCommand}" IsEnabled="{Binding IsInstalled}" />
                <Separator />
                <MenuItem Classes="danger" Header="Deinstallieren" Command="{Binding AskUninstallCommand}" IsEnabled="{Binding IsInstalled}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="6" Classes="icon" ToolTip.Tip="Auf GitHub ansehen" AutomationProperties.Name="Auf GitHub ansehen" Command="{Binding OpenRepoCommand}">
            <c:LucideIcon Width="18" Height="18" Data="{StaticResource IconInfo}" />
          </Button>
        </Grid>
      </Border>

      <!-- Laufende Mehrspieler-Sitzung -->
      <Border Background="#23261A" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="32,10"
              IsVisible="{Binding HasSession}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
          <c:LucideIcon Width="16" Height="16" Data="{StaticResource IconUsers}" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding SessionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="mono" Text="{Binding SessionCodeDisplay}" Foreground="{StaticResource TextSecondary}"
                     VerticalAlignment="Center" IsVisible="{Binding IsHosting}" ToolTip.Tip="{Binding SessionCode}" />
          <Button Grid.Column="3" Classes="secondary" IsVisible="{Binding IsHosting}" Command="{Binding CopyCodeCommand}"
                  AutomationProperties.Name="Code kopieren">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconCopy}" />
              <TextBlock Text="Code kopieren" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Aktivität | Info -->
      <Grid ColumnDefinitions="*,272" ColumnSpacing="32" Margin="32,24">
        <StackPanel Spacing="12">
          <Border Classes="sectionhead"><TextBlock Classes="overline" Text="AKTIVITÄT" /></Border>
          <TextBlock Classes="body" Text="Noch keine Meldungen zu diesem Spiel." IsVisible="{Binding !HasActivity}" />
          <ItemsControl ItemsSource="{Binding Activity}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityItemViewModel">
                <StackPanel Spacing="8">
                  <TextBlock Classes="overline" Text="{Binding DayHeader}" />
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="badge" VerticalAlignment="Center"><TextBlock Text="{Binding Kind}" /></Border>
                        <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="body" Text="{Binding StringFormat='– {0}'}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="link" FontSize="14" FontWeight="SemiBold" Content="Mehr auf GitHub"
                              Command="{Binding OpenCommand}" IsVisible="{Binding HasUrl}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="10">
          <!-- Erfolge -->
          <StackPanel Spacing="10" IsVisible="{Binding HasAchievements}" Margin="0,0,0,14">
            <Border Classes="sectionhead"><TextBlock Classes="overline" Text="ERFOLGE" /></Border>
            <Border Classes="card" Padding="12">
              <StackPanel Spacing="10">
              <TextBlock Text="{Binding AchievementsText}" FontWeight="SemiBold" FontSize="13" />
              <ProgressBar Value="{Binding AchievementsFraction}" Maximum="1" />
              <Grid ColumnDefinitions="44,*" ColumnSpacing="10" IsVisible="{Binding HasLatestAchievement}">
                <Border Width="44" Height="44" CornerRadius="3" ClipToBounds="True" Background="{StaticResource BgSelected}">
                  <Panel>
                    <Image Source="{Binding LatestAchievement.Icon, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                    <c:LucideIcon Width="22" Height="22" Data="{StaticResource IconTrophy}" Foreground="{StaticResource Brand}"
                                  IsVisible="{Binding !LatestAchievement.HasIcon, FallbackValue=False}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding LatestAchievement.Name, FallbackValue=''}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding LatestAchievement.Text, FallbackValue=''}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding UnlockedPreview}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AchievementViewModel">
                    <Border Width="38" Height="38" Margin="0,0,4,4" CornerRadius="3" ClipToBounds="True" Background="{StaticResource BgSelected}" ToolTip.Tip="{Binding Tip}">
                      <Panel>
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" Opacity="{Binding IconOpacity}" IsVisible="{Binding HasIcon}" />
                        <Panel IsVisible="{Binding !HasIcon}">
                          <c:LucideIcon Width="18" Height="18" Data="{StaticResource IconTrophy}" Foreground="{StaticResource Brand}" IsVisible="{Binding Unlocked}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <c:LucideIcon Width="18" Height="18" Data="{StaticResource IconLock}" Foreground="{StaticResource TextMuted}" IsVisible="{Binding !Unlocked}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="caption" Text="Noch offen" IsVisible="{Binding HasOpenAchievements}" />
              <ItemsControl ItemsSource="{Binding OpenPreview}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AchievementViewModel">
                    <Border Width="38" Height="38" Margin="0,0,4,4" CornerRadius="3" ClipToBounds="True" Background="{StaticResource BgSelected}" ToolTip.Tip="{Binding Tip}">
                      <Panel>
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" Opacity="{Binding IconOpacity}" IsVisible="{Binding HasIcon}" />
                        <Panel IsVisible="{Binding !HasIcon}">
                          <c:LucideIcon Width="18" Height="18" Data="{StaticResource IconTrophy}" Foreground="{StaticResource Brand}" IsVisible="{Binding Unlocked}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <c:LucideIcon Width="18" Height="18" Data="{StaticResource IconLock}" Foreground="{StaticResource TextMuted}" IsVisible="{Binding !Unlocked}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="link" Content="{Binding ShowAllAchievementsText}" Command="{Binding ShowAchievementsCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Classes="sectionhead"><TextBlock Classes="overline" Text="INFO" /></Border>
          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Classes="caption" Text="Entwickler" />
            <TextBlock Grid.Column="1" Classes="caption" Foreground="{StaticResource TextPrimary}" Text="{Binding Developer}" />
            <TextBlock Grid.Row="1" Classes="caption" Text="Erschienen" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Foreground="{StaticResource TextPrimary}" Text="{Binding ReleasedText}" />
            <TextBlock Grid.Row="2" Classes="caption" Text="Version" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="caption" Foreground="{StaticResource TextPrimary}" Text="{Binding VersionText}" />
            <TextBlock Grid.Row="3" Classes="caption" Text="Größe" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="caption" Foreground="{StaticResource TextPrimary}" Text="{Binding SizeText}" />
            <TextBlock Grid.Row="4" Classes="caption" Text="Ordner" IsVisible="{Binding HasFolder}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Classes="caption" Foreground="{StaticResource TextPrimary}" Text="{Binding FolderText}"
                       IsVisible="{Binding HasFolder}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding FolderText}" />
            <TextBlock Grid.Row="5" Classes="caption" Text="Läuft über" IsVisible="{Binding ShowRunner}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Classes="caption" Foreground="{StaticResource TextPrimary}" Text="{Binding RunnerText}"
                       IsVisible="{Binding ShowRunner}" TextWrapping="Wrap" />
          </Grid>
          <StackPanel Spacing="6" Margin="0,8,0,0">
            <Button Classes="link" Content="GitHub-Repository" Command="{Binding OpenRepoCommand}" />
            <Button Classes="link" Content="Andere Version wählen …" Command="{Binding ShowVersionsCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
