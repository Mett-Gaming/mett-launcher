<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MettLauncher.App.ViewModels"
        xmlns:c="using:MettLauncher.App.Controls"
        xmlns:v="using:MettLauncher.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="MettLauncher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Mett Launcher"
        Icon="avares://MettLauncher/Assets/icon.ico"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgApp}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="48">

  <Grid RowDefinitions="48,Auto,*,32">

    <!-- ===== Titelleiste + Hauptnavigation ===== -->
    <Border x:Name="TitleBar" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Image Source="avares://MettLauncher/Assets/icon.png" Width="32" Height="32" Margin="12,0,12,0" IsHitTestVisible="False" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button Classes="nav" Classes.active="{Binding IsLibrary}" Content="BIBLIOTHEK" Command="{Binding ShowLibraryCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsNews}" Content="NEUIGKEITEN" Command="{Binding ShowNewsCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsSettings}" Content="EINSTELLUNGEN" Command="{Binding ShowSettingsCommand}" />
        </StackPanel>
        <Border Grid.Column="2" x:Name="DragArea" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" x:Name="ChromeButtons">
          <Button Classes="chrome" x:Name="MinButton" chrome:WindowDecorationProperties.ElementRole="MinimizeButton" ToolTip.Tip="Minimieren" AutomationProperties.Name="Minimieren">
            <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconMinus}" />
          </Button>
          <Button Classes="chrome" x:Name="MaxButton" chrome:WindowDecorationProperties.ElementRole="MaximizeButton" ToolTip.Tip="Maximieren" AutomationProperties.Name="Maximieren">
            <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconMaximize}" />
          </Button>
          <Button Classes="chrome close" x:Name="CloseButton" chrome:WindowDecorationProperties.ElementRole="CloseButton" ToolTip.Tip="Schließen" AutomationProperties.Name="Schließen">
            <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconX}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Hinweise: offline / Launcher-Update ===== -->
    <StackPanel Grid.Row="1">
      <Border Background="{StaticResource InfoSubtle}" Padding="16,8" IsVisible="{Binding IsOffline}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconWifiOff}" Foreground="{StaticResource Warning}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="caption" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Offline – GitHub nicht erreichbar. Installierte Spiele starten trotzdem, Neuigkeiten und Versionen sind vom letzten Abruf." />
          <Button Grid.Column="2" Classes="link" Content="Erneut versuchen" Command="{Binding RetryCommand}" />
        </Grid>
      </Border>
      <Border Background="#2C2218" BorderBrush="{StaticResource BorderStrong}" BorderThickness="0,0,0,1" Padding="16,6" IsVisible="{Binding HasLauncherUpdate}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <c:LucideIcon Width="16" Height="16" Data="{StaticResource IconDownload}" Foreground="{StaticResource Brand}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding LauncherUpdateText}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
          <Button Grid.Column="2" Classes="ghost" Content="Später" Command="{Binding DismissLauncherUpdateCommand}" />
          <Button Grid.Column="3" Classes="primary" Content="Jetzt neu starten" Command="{Binding RestartForUpdateCommand}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- ===== BIBLIOTHEK ===== -->
    <Grid Grid.Row="2" ColumnDefinitions="280,*" IsVisible="{Binding IsLibrary}">
      <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,12,0,0">
            <Button Classes="side" Padding="14,8" Command="{Binding ShowNewsCommand}" AutomationProperties.Name="Startseite">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:LucideIcon Width="16" Height="16" Data="{StaticResource IconHome}" />
                <TextBlock Text="STARTSEITE" FontWeight="Bold" FontSize="13" LetterSpacing="0.5" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Grid Margin="12,0">
              <TextBox Classes="search" PlaceholderText="Suchen" Text="{Binding SearchText}" />
              <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconSearch}" Foreground="{StaticResource TextMuted}"
                            HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,4,0,0">
              <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconChevronDown}" Foreground="{StaticResource TextMuted}" />
              <TextBlock Classes="overline" FontSize="12" Text="SPIELE" />
              <TextBlock Classes="caption" Text="{Binding GamesHeader}" />
            </StackPanel>
          </StackPanel>
          <ListBox Classes="library" ItemsSource="{Binding FilteredGames}" SelectedItem="{Binding SelectedGame}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GameViewModel">
                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <Border Width="20" Height="20" CornerRadius="2" ClipToBounds="True" Background="{StaticResource BgSelected}">
                    <Panel>
                      <TextBlock Text="{Binding Name, Converter={x:Static v:InitialConverter.Instance}}" FontFamily="{StaticResource DisplayFont}"
                                 FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brand}"
                                 IsVisible="{Binding !HasCover}" />
                      <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                    </Panel>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Opacity="{Binding SidebarDimmed, Converter={x:Static v:DimConverter.Instance}}" />
                  <TextBlock Grid.Column="2" Classes="caption" Text="{Binding SidebarCount}" VerticalAlignment="Center" ToolTip.Tip="Erfolge"
                             IsVisible="{Binding SidebarCount, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Grid.Column="2" Text="{Binding SidebarStatus}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentHover}" Classes.update="{Binding SidebarStatusIsHighlight}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
              <Style Selector="TextBlock.update">
                <Setter Property="Foreground" Value="{StaticResource Highlight}" />
              </Style>
            </ListBox.Styles>
          </ListBox>
        </DockPanel>
      </Border>

      <Panel Grid.Column="1">
        <ContentControl Content="{Binding SelectedGame}" IsVisible="{Binding HasSelectedGame}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:GameViewModel">
              <v:GameView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        <StackPanel IsVisible="{Binding ShowEmptyLibrary}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Classes="h1" Text="Noch keine Spiele" HorizontalAlignment="Center" />
          <TextBlock Classes="body" Text="Der Spielekatalog konnte nicht geladen werden." HorizontalAlignment="Center" />
          <Button Classes="secondary" Content="Erneut versuchen" Command="{Binding RetryCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
    </Grid>

    <!-- ===== NEUIGKEITEN ===== -->
    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsNews}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="960" Margin="40,24" Spacing="14">
        <Border Classes="sectionhead"><TextBlock Classes="overline" FontSize="12" Text="NEUIGKEITEN" /></Border>
        <TextBlock Classes="body" Text="Noch keine Neuigkeiten." IsVisible="{Binding !HasNews}" />
        <ItemsControl ItemsSource="{Binding NewsItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NewsItemViewModel">
              <Button Classes="newscard" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
                  <Border Height="72" CornerRadius="2" ClipToBounds="True" Background="{StaticResource HeroFallback}" VerticalAlignment="Top">
                    <Image Source="{Binding Image}" Stretch="UniformToFill" IsVisible="{Binding HasImage}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="overline" Text="{Binding Meta}" />
                    <TextBlock Classes="title" Text="{Binding Title}" />
                    <TextBlock Classes="body" Text="{Binding Excerpt}" IsVisible="{Binding HasExcerpt}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.Styles>
            <Style Selector="Button.newscard">
              <Setter Property="Background" Value="{StaticResource BgSurface}" />
              <Setter Property="Padding" Value="12" />
              <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            </Style>
            <Style Selector="Button.newscard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{StaticResource BgRaised}" />
            </Style>
          </ItemsControl.Styles>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== EINSTELLUNGEN ===== -->
    <Grid Grid.Row="2" ColumnDefinitions="280,*" IsVisible="{Binding IsSettings}">
      <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,16,0,0">
          <Button Classes="side" Classes.active="{Binding IsCatLibrary}" Content="Bibliothek" Command="{Binding ShowSettingsLibraryCommand}" />
          <Button Classes="side" Classes.active="{Binding IsCatUpdates}" Content="Downloads &amp; Updates" Command="{Binding ShowSettingsUpdatesCommand}" />
          <Button Classes="side" Classes.active="{Binding IsCatOverlay}" Content="Overlay &amp; Erfolge" Command="{Binding ShowSettingsOverlayCommand}" />
          <Button Classes="side" Classes.active="{Binding IsCatMultiplayer}" Content="Mehrspieler" Command="{Binding ShowSettingsMultiplayerCommand}" />
          <Button Classes="side" Classes.active="{Binding IsCatProton}" Content="Proton" Command="{Binding ShowSettingsProtonCommand}" IsVisible="{Binding IsLinux}" />
          <Button Classes="side" Classes.active="{Binding IsCatAbout}" Content="Über" Command="{Binding ShowSettingsAboutCommand}" />
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="40,24" Spacing="4" MaxWidth="820" HorizontalAlignment="Left">
          <!-- Bibliothek -->
          <StackPanel IsVisible="{Binding IsCatLibrary}">
            <TextBlock Classes="h1" Text="Bibliothek" Margin="0,0,0,8" />
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="Speicherort für Spiele" FontWeight="SemiBold" />
                  <TextBlock Classes="mono" Text="{Binding LibraryDir}" TextTrimming="PrefixCharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Öffnen" Command="{Binding OpenLibraryDirCommand}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="secondary" Content="Ändern …" Command="{Binding ChangeLibraryDirCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock Classes="caption" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Neue Installationen landen im neuen Ordner. Bereits installierte Spiele bleiben, wo sie sind." />
          </StackPanel>
          <!-- Updates -->
          <StackPanel IsVisible="{Binding IsCatUpdates}">
            <TextBlock Classes="h1" Text="Downloads &amp; Updates" Margin="0,0,0,8" />
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="Spiele automatisch aktualisieren" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Beim Start des Launchers. Festgepinnte Versionen sind ausgenommen." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdateGames}" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="Vorabversionen anbieten" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Pre-Releases von GitHub in „Version wählen“ zeigen." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IncludePrereleases}" />
              </Grid>
            </Border>
          </StackPanel>
          <!-- Overlay -->
          <StackPanel IsVisible="{Binding IsCatOverlay}">
            <TextBlock Classes="h1" Text="Overlay &amp; Erfolge" Margin="0,0,0,8" />
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Overlay in Spielen" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Erfolge und das Overlay direkt im Spiel zeigen." TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding OverlayEnabled}" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Ecke für Einblendungen" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Wo neue Erfolge erscheinen." TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="230" ItemsSource="{Binding CornerNames}" SelectedIndex="{Binding OverlayCorner}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Ton bei neuen Erfolgen" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Ein kurzer Klang." TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding OverlaySound}" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Overlay öffnen" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Am Controller: Select und Start zusammen. Das Spiel muss es unterstützen." TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="230" ItemsSource="{Binding OverlayKeyNames}" SelectedIndex="{Binding OverlayKey}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Leiste zeigen" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Bildrate, Uhr und Dauer der Sitzung." TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding OverlayBar}" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Ecke für die Leiste" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Am besten nicht dort, wo das Spiel selbst etwas zeigt." TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="230" ItemsSource="{Binding CornerNames}" SelectedIndex="{Binding OverlayBarCorner}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Launcher schließen, während ein Spiel läuft" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Erfolge zählen nur, solange der Launcher läuft." TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="230" ItemsSource="{Binding BackgroundNames}" SelectedIndex="{Binding KeepInBackground}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock Classes="caption" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding OverlayHint}" />
          </StackPanel>
          <!-- Mehrspieler -->
          <StackPanel IsVisible="{Binding IsCatMultiplayer}">
            <TextBlock Classes="h1" Text="Mehrspieler" Margin="0,0,0,8" />
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="In Discord zeigen, was ich spiele" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="Spiel, Spielzeit und was das Spiel über sich meldet. Beitrittscodes werden nie gezeigt." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordPresence}" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="Anzeigename" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Pflicht für den Mehrspieler: So sehen dich deine Mitspieler (2–24 Zeichen)." />
                  <TextBlock Classes="caption" Foreground="{StaticResource Danger}" Text="{Binding DisplayNameError}" IsVisible="{Binding DisplayNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding DisplayName}" MaxLength="24" PlaceholderText="Dein Name" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="secondary" Content="Speichern" Command="{Binding SaveDisplayNameCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="Status" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="{Binding NetStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Meine ID kopieren" Command="{Binding CopyOwnIdCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock Classes="caption" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="{Binding MultiplayerHint}" />
          </StackPanel>
          <!-- Proton (nur Linux) -->
          <StackPanel IsVisible="{Binding IsCatProton}">
            <TextBlock Classes="h1" Text="Proton" Margin="0,0,0,8" />
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="GE-Proton (vom Launcher verwaltet)" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="{Binding ProtonInfo}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding ProtonUpdateStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="Nach neuer Version suchen" Command="{Binding UpdateProtonCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <StackPanel Spacing="2">
                <TextBlock Text="Proton aus Steam" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding SteamProtonInfo}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="Pro Spiel wählbar über das Zahnrad → „Proton-Version …“." />
              </StackPanel>
            </Border>
            <Border Classes="settingrow">
              <StackPanel Spacing="2">
                <TextBlock Text="umu-launcher" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding UmuInfo}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="Proton-Log schreiben" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Für die Fehlersuche, wenn ein Spiel nicht startet. Die Logs landen im Launcher-Ordner unter logs." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Logs öffnen" Command="{Binding OpenProtonLogsCommand}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding ProtonLog}" />
              </Grid>
            </Border>
          </StackPanel>
          <!-- Über -->
          <StackPanel IsVisible="{Binding IsCatAbout}">
            <TextBlock Classes="h1" Text="Über" Margin="0,0,0,8" />
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding LauncherVersion, StringFormat='Mett Launcher {0}'}" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="{Binding LauncherUpdateStatus}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="Nach Updates suchen" Command="{Binding CheckForLauncherUpdateCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingrow">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="Quellcode &amp; Releases" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="Alle Spiele und der Launcher liegen öffentlich auf GitHub." />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="github.com/Mett-Gaming" Command="{Binding OpenOrgCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock Classes="caption" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="Schriften: Archivo, Archivo Black, JetBrains Mono (SIL Open Font License). Icons: Lucide (ISC)." />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ===== Download-Leiste ===== -->
    <Border Grid.Row="3" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
      <Panel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding HasToolDownload}">
          <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconDownload}" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center" />
          <TextBlock Classes="caption" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Text="{Binding ToolDownloadText}" />
          <TextBlock Classes="caption" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Text="{Binding ToolDownloadDetail}" />
          <ProgressBar Width="160" Value="{Binding ToolDownloadProgress}" Maximum="1" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding ShowIdleDownloads}">
          <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconDownload}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          <TextBlock Classes="caption" Text="{Binding DownloadIdleText}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding HasDownload}">
          <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconDownload}" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center" />
          <TextBlock Classes="caption" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                     Text="{Binding ActiveDownload.Name, StringFormat='DOWNLOADS · {0}', FallbackValue=''}" />
          <TextBlock Classes="caption" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                     Text="{Binding ActiveDownload.ProgressText, FallbackValue=''}" />
          <ProgressBar Width="160" Value="{Binding ActiveDownload.Progress, FallbackValue=0}" Maximum="1" VerticalAlignment="Center" />
        </StackPanel>
      </Panel>
    </Border>

    <!-- ===== Fehlermeldung ===== -->
    <Border Grid.Row="2" Classes="dialog" Padding="14,10" Margin="16" MaxWidth="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            BorderBrush="{StaticResource Danger}" IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="ghost" Padding="6" Command="{Binding DismissErrorCommand}" VerticalAlignment="Top">
          <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconX}" />
        </Button>
      </Grid>
    </Border>

    <!-- ===== Dialoge ===== -->
    <Panel Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding IsAnyDialogOpen}">
      <Border Background="{StaticResource Scrim}" x:Name="Scrim" />

      <!-- Version wählen -->
      <Border Classes="dialog" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsVersionDialogOpen}">
        <StackPanel Spacing="12">
          <TextBlock Classes="h1" Text="{Binding VersionDialogGame.Name, StringFormat='{}{0} – Version wählen', FallbackValue=''}" />
          <TextBlock Classes="body" Text="Ältere Versionen kannst du jederzeit installieren. Eine festgepinnte Version wird nicht automatisch aktualisiert. Einstellungen des Spiels bleiben erhalten." />
          <ScrollViewer MaxHeight="360">
            <ItemsControl ItemsSource="{Binding VersionDialogGame.Versions, FallbackValue={x:Null}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VersionItemViewModel">
                  <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                          CornerRadius="{StaticResource RadiusMd}" Padding="14,8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="14">
                      <TextBlock Classes="mono" FontSize="14" Foreground="{StaticResource TextPrimary}" Text="{Binding Version}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Date}" VerticalAlignment="Center" />
                      <Border Grid.Column="2" Classes="badge" Classes.success="{Binding IsInstalled}" Classes.brand="{Binding IsPinned}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BadgeText}" />
                      </Border>
                      <TextBlock Grid.Column="4" Classes="caption" Text="{Binding Size}" VerticalAlignment="Center" />
                      <Button Grid.Column="5" Classes="secondary" Content="Installieren" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
                      <Button Grid.Column="5" Classes="ghost" Content="{Binding PinLabel}" Command="{Binding TogglePinCommand}" IsVisible="{Binding IsInstalled}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Classes="secondary" Content="Schließen" HorizontalAlignment="Right" Command="{Binding CloseDialogsCommand}" />
        </StackPanel>
      </Border>

      <!-- Anzeigename festlegen (Pflicht für Mehrspieler) -->
      <Border Classes="dialog" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsNameDialogOpen}">
        <StackPanel Spacing="14">
          <TextBlock Classes="h1" Text="Anzeigename festlegen" />
          <TextBlock Classes="body" Text="{Binding NameDialogText}" />
          <TextBox Text="{Binding NameDialogInput}" MaxLength="24" PlaceholderText="Dein Name" AutomationProperties.Name="Anzeigename" />
          <TextBlock Classes="caption" Foreground="{StaticResource Danger}" Text="{Binding NameDialogError}"
                     IsVisible="{Binding NameDialogError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Abbrechen" Command="{Binding CloseDialogsCommand}" />
            <Button Classes="primary" Content="Speichern" Command="{Binding ConfirmNameCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Beitreten -->
      <Border Classes="dialog" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsJoinDialogOpen}">
        <StackPanel Spacing="14">
          <TextBlock Classes="h1" Text="{Binding JoinDialogGame.Name, StringFormat='{}{0} – Beitreten', FallbackValue=''}" />
          <TextBlock Classes="body" Text="Füge den Code ein, den dir der Host geschickt hat. Der Launcher startet das Spiel und verbindet dich." />
          <TextBox Text="{Binding JoinCode}" PlaceholderText="Code einfügen" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Code" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Abbrechen" Command="{Binding CloseDialogsCommand}" />
            <Button Classes="primary" Content="Beitreten" Command="{Binding ConfirmJoinCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Proton-Version wählen -->
      <Border Classes="dialog" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsProtonDialogOpen}">
        <StackPanel Spacing="12">
          <TextBlock Classes="h1" Text="{Binding ProtonDialogGame.Name, StringFormat='{}{0} – Proton-Version', FallbackValue=''}" />
          <TextBlock Classes="body" Text="Standard ist die neueste GE-Proton. Eine feste Version hilft, wenn ein Spiel mit einer neueren Version Probleme hat." />
          <ItemsControl ItemsSource="{Binding ProtonOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProtonOptionViewModel">
                <Button Classes="side" Classes.active="{Binding IsSelected}" Padding="12,8" Command="{Binding SelectCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <c:LucideIcon Width="14" Height="14" Data="{StaticResource IconCheck}" IsVisible="{Binding IsSelected}" Foreground="{StaticResource AccentHover}" />
                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="secondary" Content="Schließen" HorizontalAlignment="Right" Command="{Binding CloseDialogsCommand}" />
        </StackPanel>
      </Border>

      <!-- Update vor dem Spielstart -->
      <Border Classes="dialog" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLaunchUpdateOpen}">
        <StackPanel Spacing="14">
          <TextBlock Classes="h1" Text="Update verfügbar" />
          <TextBlock Classes="body" Text="{Binding LaunchUpdatePromptText}" />
          <TextBlock Classes="mono" FontSize="14" Foreground="{StaticResource TextPrimary}" Text="{Binding LaunchUpdateVersions}" />
          <TextBlock Classes="caption" Text="{Binding LaunchUpdateHint}" TextWrapping="Wrap"
                     IsVisible="{Binding LaunchUpdateHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="caption" Foreground="{StaticResource Danger}" Text="{Binding LaunchUpdateError}" TextWrapping="Wrap"
                     IsVisible="{Binding LaunchUpdateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Abbrechen" Command="{Binding CloseDialogsCommand}" />
            <Button Classes="secondary" Content="Ohne Update starten" Command="{Binding LaunchUpdateSkipCommand}" />
            <Button Classes="primary" Content="Aktualisieren und starten" Command="{Binding LaunchUpdateAcceptCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Alle Erfolge -->
      <Border Classes="dialog" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsAchievementsOpen}">
        <StackPanel Spacing="12">
          <TextBlock Classes="h1" Text="{Binding AchievementsGame.Name, StringFormat='{}{0} – Erfolge', FallbackValue=''}" />
          <TextBlock Classes="body" Text="{Binding AchievementsGame.AchievementsText, FallbackValue=''}" />
          <ProgressBar Value="{Binding AchievementsGame.AchievementsFraction, FallbackValue=0}" Maximum="1" />
          <ScrollViewer MaxHeight="440">
            <ItemsControl ItemsSource="{Binding AchievementsGame.Achievements, FallbackValue={x:Null}}" Margin="0,0,14,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AchievementViewModel">
                  <Border Classes="card" Padding="10">
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                      <Border Width="44" Height="44" CornerRadius="3" ClipToBounds="True" Background="{StaticResource BgSelected}">
                        <Panel>
                          <Image Source="{Binding Icon}" Stretch="UniformToFill" Opacity="{Binding IconOpacity}" IsVisible="{Binding HasIcon}" />
                          <Panel IsVisible="{Binding !HasIcon}">
                            <c:LucideIcon Width="22" Height="22" Data="{StaticResource IconTrophy}" Foreground="{StaticResource Brand}" IsVisible="{Binding Unlocked}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <c:LucideIcon Width="22" Height="22" Data="{StaticResource IconLock}" Foreground="{StaticResource TextMuted}" IsVisible="{Binding !Unlocked}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Panel>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Fraction}" Maximum="1" IsVisible="{Binding ShowProgress}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Info}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Classes="secondary" Content="Schließen" HorizontalAlignment="Right" Command="{Binding CloseDialogsCommand}" />
        </StackPanel>
      </Border>

      <!-- Schließen, während ein Spiel läuft -->
      <Border Classes="dialog" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLeaveDialogOpen}">
        <StackPanel Spacing="14">
          <TextBlock Classes="h1" Text="Ein Spiel läuft noch" />
          <TextBlock Classes="body" Text="Ohne den Launcher zählen keine Erfolge, und eine Mehrspieler-Sitzung bricht ab. Soll er im Hintergrund weiterlaufen?" />
          <CheckBox Content="Nicht mehr fragen" IsChecked="{Binding RememberLeave}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Abbrechen" Command="{Binding CloseDialogsCommand}" />
            <Button Classes="secondary" Content="Beenden" Command="{Binding LeaveAndQuitCommand}" />
            <Button Classes="primary" Content="Im Hintergrund weiterlaufen" Command="{Binding LeaveToBackgroundCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Bestätigen -->
      <Border Classes="dialog" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsConfirmOpen}">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource DangerSubtle}">
              <c:LucideIcon Width="18" Height="18" Data="{StaticResource IconTrash}" Foreground="{StaticResource Danger}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="h1" Text="{Binding ConfirmTitle}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="body" Text="{Binding ConfirmText}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Abbrechen" Command="{Binding CloseDialogsCommand}" />
            <Button Classes="danger" Content="{Binding ConfirmButton}" Command="{Binding ConfirmAcceptCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</Window>
